---
import { NAV, QUOTE_HREF, SITE } from '../consts';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="container">
    <a href="/" class="brand" aria-label={SITE.name}>
      <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M4 28V12L16 4L28 12V28H20V19H12V28H4Z" fill="#0b3d91"/>
        <path d="M12 19H20V28H12V19Z" fill="#e85d1a"/>
        <rect x="7" y="15" width="3" height="3" fill="#fff" opacity="0.9"/>
        <rect x="22" y="15" width="3" height="3" fill="#fff" opacity="0.9"/>
        <rect x="7" y="20" width="3" height="3" fill="#fff" opacity="0.9"/>
        <rect x="22" y="20" width="3" height="3" fill="#fff" opacity="0.9"/>
      </svg>
      <span>assurance-<b>immeuble</b>.fr</span>
    </a>
    <button class="menu-toggle" aria-label="Ouvrir le menu" aria-expanded="false" data-menu>
      <i class="ti ti-menu-2" aria-hidden="true"></i>
    </button>
    <nav class="nav" data-nav>
      {NAV.map((item) => (
        <a href={item.href} aria-current={(item.href === '/' ? path === '/' : path.startsWith(item.href)) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a href={QUOTE_HREF} class="btn btn--primary" style="padding:9px 16px;">Devis en 24 h</a>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector('[data-menu]');
  const nav = document.querySelector('[data-nav]');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
</script>
