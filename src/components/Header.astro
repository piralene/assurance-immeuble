---
import { NAV, QUOTE_HREF, SITE } from '../consts';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="container">
    <a href="/" class="brand" aria-label={SITE.name}>
      <svg width="34" height="34" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M32 4 C42 4 54 8 54 8 L54 32 C54 46 44 56 32 60 C20 56 10 46 10 32 L10 8 C10 8 22 4 32 4 Z" fill="#0b3d91"/>
        <rect x="18" y="22" width="12" height="26" fill="#ffffff"/>
        <rect x="34" y="18" width="12" height="30" fill="#ffffff"/>
        <polygon points="18,22 24,17 30,22" fill="#ffffff"/>
        <polygon points="34,18 40,13 46,18" fill="#ffffff"/>
        <rect x="20.5" y="26" width="3" height="3" fill="#0b3d91"/>
        <rect x="24.5" y="26" width="3" height="3" fill="#0b3d91"/>
        <rect x="20.5" y="32" width="3" height="3" fill="#0b3d91"/>
        <rect x="24.5" y="32" width="3" height="3" fill="#0b3d91"/>
        <rect x="20.5" y="38" width="3" height="3" fill="#0b3d91"/>
        <rect x="24.5" y="38" width="3" height="3" fill="#0b3d91"/>
        <rect x="36.5" y="22" width="3" height="3" fill="#0b3d91"/>
        <rect x="40.5" y="22" width="3" height="3" fill="#0b3d91"/>
        <rect x="36.5" y="28" width="3" height="3" fill="#0b3d91"/>
        <rect x="40.5" y="28" width="3" height="3" fill="#0b3d91"/>
        <rect x="36.5" y="34" width="3" height="3" fill="#0b3d91"/>
        <rect x="40.5" y="34" width="3" height="3" fill="#0b3d91"/>
        <rect x="36.5" y="40" width="3" height="3" fill="#0b3d91"/>
        <rect x="40.5" y="40" width="3" height="3" fill="#0b3d91"/>
        <circle cx="32" cy="52" r="4.5" fill="#e85d1a"/>
        <path d="M29.7 52.3 L31.2 53.8 L34.3 50.7" stroke="#ffffff" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>assurance-<b>immeuble</b>.fr</span>
    </a>
    <button class="menu-toggle" aria-label="Ouvrir le menu" aria-expanded="false" data-menu>
      <i class="ti ti-menu-2" aria-hidden="true"></i>
    </button>
    <nav class="nav" data-nav>
      {NAV.map((item) => (
        <a href={item.href} aria-current={(item.href === '/' ? path === '/' : path.startsWith(item.href)) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a href={QUOTE_HREF} class="btn btn--primary" style="padding:9px 16px;">Devis en 24 h</a>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector('[data-menu]');
  const nav = document.querySelector('[data-nav]');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  });
</script>
